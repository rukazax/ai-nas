    <!-- Справка по подключению -->
    <string name="help_title">Справка по подключению</string>
    <string name="help_intro">Сервер доступен по двум адресам — выбирайте по ситуации:</string>
    <string name="help_item_public">🌍 Из интернета (везде, где есть сеть): введите your_server.com. Работает через домашний Wi-Fi и мобильный интернет.</string>
    <string name="help_item_home">🏠 Дома (та же Wi-Fi сеть): введите 192.168.88.35 — дашборд откроется напрямую, без интернета.</string>
    <string name="help_item_creds">🔑 Пользователь и пароль — те же, что на сервере (учётка Linux). Приложение перепробует все известные маршруты автоматически: DSH-API, публичный дашборд, локальный :8890.</string>
    <string name="help_item_trouble">🛠 Если «Сервер недоступен»: 1) проверьте, что телефон в сети (сайт your_server.com открывается в браузере); 2) из дома попробуйте IP, извне — только домен; 3) пароль вводите внимательно — 401 означает неверные данные, а не проблему сети.</string>
    <string name="help_hide">Скрыть справку</string>

