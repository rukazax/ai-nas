<?xml version="1.0" encoding="utf-8"?>
<!-- Дашборд NAS в домашней сети живёт на http://<ip>:8890, поэтому cleartext
     разрешён глобально: пользователь может указать любой LAN-адрес сервера. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
