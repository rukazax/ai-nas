    <string name="help_title">Connection help</string>
    <string name="help_intro">The server answers on two addresses — pick one for your situation:</string>
    <string name="help_item_public">🌍 From the internet (anywhere): enter your_server.com. Works both on home Wi-Fi and mobile data.</string>
    <string name="help_item_home">🏠 At home (same Wi-Fi): enter 192.168.88.35 — the dashboard opens directly, no internet needed.</string>
    <string name="help_item_creds">🔑 Use the same Linux account as on the server. The app automatically tries every known route: DSH API, public dashboard, local :8890.</string>
    <string name="help_item_trouble">🛠 If it says “Server unreachable”: 1) make sure the phone is online (open your_server.com in a browser); 2) at home try the IP, away from home — only the domain; 3) type the password carefully — 401 means wrong credentials, not a network problem.</string>
